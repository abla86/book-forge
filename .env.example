# Google Gemini API
# Keep the real value in your deployment secret manager. Never commit credentials.
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
# Optional model override. Default: gemini-3.8-flash
GEMINI_MODEL="gemini-3.8-flash"

# Public application URL used by the hosting environment when required.
APP_URL="https://YOUR_APP_HOST"

# Initial founder password. Minimum 15 characters.
# Set this only through a secret manager/environment configuration.
FOUNDER_PASSWORD="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Required for production persistence.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
